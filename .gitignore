@'
# Dependencies
node_modules/

# Build output
dist/
build/
coverage/

# Environment variables
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# Vite
.vite/

# Prisma/local databases
*.db
*.db-journal

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Temporary files
tmp/
temp/
'@ | Set-Content -Encoding utf8 .gitignore